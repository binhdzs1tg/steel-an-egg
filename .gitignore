# Godot 4+ specific ignores
.godot/
/android/
/builds/

# Mono / C# (if used)
.mono/
data_*/

# OS-specific
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Export artifacts (build output only)
*.exe
*.pck
*.zip
/export/

# Note: export_presets.cfg IS committed so CI can build the project
# (override the default Godot gitignore which excludes it)

# Logs
*.log

# Local user data (only relevant on dev machine, but ignore if copied)
user://
