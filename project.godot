;
; Steel An Egg — Godot 4.7.2 Project Configuration
; A 3D single-player collection / simulation / adventure game
;

config_version=5

[application]

config/name="Steel An Egg"
config/description="A 3D offline single-player game about collecting eggs, hatching pets, and progressing through biomes."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DataRegistry="*res://scripts/autoload/DataRegistry.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
Economy="*res://scripts/autoload/Economy.gd"
Collection="*res://scripts/autoload/Collection.gd"
QuestSystem="*res://scripts/autoload/QuestSystem.gd"
AchievementSystem="*res://scripts/autoload/AchievementSystem.gd"
NotificationSystem="*res://scripts/autoload/NotificationSystem.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
InputMapHelper="*res://scripts/autoload/InputMapHelper.gd"

[display]

window/size/width=1280
window/size/height=720
window/size/resizable=true
window/size/fullscreen=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)
]
}
move_backward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)
]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)
]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)
]
}
shift_lock={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)
]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)
]
}
inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":73)
]
}
collection={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67)
]
}
upgrades={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":85)
]
}
quests={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)
]
}
camera_zoom_in={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":4)
]
}
camera_zoom_out={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":5)
]
}
camera_reset={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)
]
}

[layer_names]

3d_render/layer_1="World"
3d_render/layer_2="Player"
3d_render/layer_3="Eggs"
3d_render/layer_4="Pets"
3d_render/layer_5="NPCs"
3d_render/layer_6="UI"

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]

; Perf: MSAA + TAA together were expensive for this low-poly world.
; MSAA is disabled and TAA off — the game renders crisp without them and
; low-end GPUs get a large headroom back.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.55, 0.75, 0.95, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
